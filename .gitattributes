# Shell scripts run on the Linux VPS: always keep LF line endings, even on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Compiled Wokwi chips are binary.
*.wasm binary

# Mosquitto config files are read on Linux: always keep LF.
infra/mosquitto/mosquitto.conf text eol=lf
infra/mosquitto/acl text eol=lf