# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_DB=smartfootball
POSTGRES_USER=smartfootball
POSTGRES_PASSWORD=change-me

# Mosquitto (one account per device, one for the backend)
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
MQTT_DEVICE_USER=goal-esp32-01
MQTT_DEVICE_PASSWORD=change-me

# Backend
API_SECRET_KEY=change-me
DATABASE_URL=postgresql://smartfootball:change-me@db:5432/smartfootball

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me
